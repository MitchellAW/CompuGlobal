{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ruff check",
      "type": "shell",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "--watch",
        "--output-format",
        "github",
        "."
      ],
      "problemMatcher": [
        {
          "source": "Ruff",
          "owner": "Ruff",
          "severity": "warning",
          "background": {
            "beginsPattern": "\\[[^\\]]+\\] Found \\d+ errors\\. Watching for file changes\\.",
            "endsPattern": "^$"
          },
          "pattern": [
            {
              "regexp": "^::\\w+ title=ruff \\(([^)]+)\\),file=[^,]+,line=(\\d+),col=(\\d+),endLine=(\\d+),endColumn=(\\d+)::([^:]+):\\d+:\\d+: [^\\s]+ (.*)$",
              "code": 1,
              "line": 2,
              "column": 3,
              "endLine": 4,
              "endColumn": 5,
              "file": 6,
              "message": 7
            }
          ]
        }
      ]
    },
    {
      "label": "pyrefly check",
      "type": "shell",
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      },
      "command": "uvx",
      "args": [
        "pyrefly",
        "check",
        "--summarize-errors"
      ]
    },
    {
      "label": "pydoclint",
      "command": "uv",
      "args": [
        "run",
        "pydoclint",
        "--style",
        "numpy",
        "compuglobal"
      ],
      "group": {
        "isDefault": true,
        "kind": "none"
      },
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": {
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "owner": "pydoclint",
        "severity": "warning",
        "pattern": [
          {
            "regexp": "^(\\S.*\\.py)$",
            "file": 1
          },
          {
            "regexp": "^\\s+(\\d+):\\s+(DOC\\d+):\\s+(.*)$",
            "line": 1,
            "code": 2,
            "message": 3,
            "loop": true
          }
        ]
      },
      "type": "shell"
    },
    {
      "label": "sphinx-autobuild",
      "command": "uv",
      "args": [
        "run",
        "sphinx-autobuild",
        "docs/",
        "docs/_build/html",
        "--open-browser"
      ],
      "type": "shell",
      "presentation": {
        "echo": true,
        "reveal": "never",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
